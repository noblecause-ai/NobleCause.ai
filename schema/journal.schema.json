{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journal.schema.json",
  "title": "Wart-Journal-Eintrag (journal/<date>/entry.json)",
  "description": "EIN Schema für alle Eintragstypen (Research, Vertretung, Einberufung, Bootstrap, Kommission). Gemeinsame Kopffelder sind Pflicht, alles Typspezifische optional, additionalProperties: true — der Bestand validiert unverändert. Abnahmetest ist der Bestand selbst: schlägt er fehl, ist das Schema falsch, nicht der Rekord.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "date", "session_ref", "search_queries", "content_md",
    "costs", "actions_run_url"
  ],
  "allOf": [{
    "if": {
      "properties": { "kind": { "const": "refusal" } },
      "required": ["kind"]
    },
    "then": {
      "required": ["kind", "refusal", "refusal_note", "refusals"],
      "properties": {
        "schema_version": { "const": 2 },
        "refusal": { "const": true },
        "refusals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["family", "model", "stop_reason", "raw_artifact_dir", "search_queries"],
            "properties": {
              "family": { "type": "string" },
              "model": { "type": "string" },
              "stop_reason": { "const": "refusal" },
              "raw_artifact_dir": { "type": "string" },
              "search_queries": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "not": {
        "anyOf": [
          { "required": ["convene"] },
          { "required": ["convene_rationale"] }
        ]
      }
    },
    "else": {
      "required": ["convene", "convene_rationale", "delta_assessment", "findings", "rejected_findings"]
    }
  }],
  "properties": {
    "schema_version": { "type": "integer" },
    "date": { "type": "string" },
    "session_ref": { "type": ["string", "null"], "description": "geltende Sitzung; null bei Einträgen ohne Sitzungsbezug (Kommission)" },
    "convene": { "type": "boolean" },
    "convene_rationale": { "type": "string" },
    "delta_assessment": { "type": "string" },
    "findings": { "type": "array" },
    "rejected_findings": { "type": "array" },
    "search_queries": { "type": "array" },
    "content_md": { "type": "string" },
    "costs": { "type": "object" },
    "actions_run_url": { "type": ["string", "null"] },
    "kind": { "enum": ["research", "refusal"] },
    "refusal": { "type": "boolean" },
    "refusal_note": { "type": "string" },
    "refusal_note_en": { "type": "string" },
    "refusals": { "type": "array" },
    "type": { "type": "string", "description": "Eintragstyp (optional; fehlt beim Research-Lauf)" },
    "model": { "type": ["string", "null"] },
    "model_label": { "type": "string" },
    "deputation_note": { "type": "string" },
    "commission_ref": { "type": "string" },
    "correction_notice": {
      "type": "object",
      "description": "§7 — Korrekturhinweis nach dem Muster vom 14. Juli (kein Redigieren des Rekords, nur ein transparenter Vermerk). Wortlaut liefert der Wart, DE in `text`, EN in `text_en`.",
      "required": ["date", "text"],
      "properties": {
        "date": { "type": "string" },
        "text": { "type": "string" },
        "text_en": { "type": "string" },
        "commit": { "type": "string" }
      }
    }
  }
}
