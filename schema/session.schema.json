{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noblecause.ai/schema/session.schema.json",
  "title": "Gremium-Sitzungsprotokoll (sessions/<id>/session.json)",
  "description": "Historische Rekorde bleiben bei schema_version 2. Neue Live-Ratsrekorde verwenden schema_version 3 und procedure_version 0.6; schema_gate prüft zusätzlich den verknüpften Ereignisrekord. additionalProperties:true erlaubt additive Weiterentwicklung.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "number",
    "date",
    "title",
    "question",
    "summary",
    "dissent_highlights",
    "participants",
    "prompts",
    "rounds",
    "dissent_md",
    "recommendations",
    "unresolved_votes",
    "costs"
  ],
  "properties": {
    "council_transport": {
      "const": "openrouter_api"
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        2,
        3
      ]
    },
    "id": {
      "type": "string",
      "description": "z.B. 2026-07, 2026-07b"
    },
    "number": {
      "type": "integer",
      "description": "eindeutige Sitzungsnummer (Sortier-Schlüssel)"
    },
    "date": {
      "type": "string",
      "description": "ISO-Datum YYYY-MM-DD"
    },
    "title": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "modellgeschriebene Leserfassung"
    },
    "dissent_highlights": {
      "description": "Liste ODER String — inkonsistent",
      "type": [
        "array",
        "string"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "model",
          "label"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "prompts": {
      "type": "object",
      "description": "wörtliche Prompt-Vorlagen des Laufs"
    },
    "rounds": {
      "type": "array",
      "description": "diskriminierte Union über 'kind'",
      "items": {
        "type": "object",
        "required": [
          "round",
          "kind"
        ],
        "properties": {
          "round": {
            "type": "number"
          },
          "kind": {
            "enum": [
              "wart_opening",
              "wart_dossier",
              "wart_moderation",
              "initial_vote",
              "addressed_challenge",
              "final_vote",
              "live_debate"
            ]
          },
          "content_md": {
            "type": "string"
          },
          "wart": {
            "type": "object"
          },
          "exchanges": {
            "type": "array",
            "description": "Deliberation 0.5: je Ratsmodell eine verpflichtende adressierte Erwiderung oder ein sichtbarer Ausfall. Nur strukturierte Schlussvoten werden aggregiert.",
            "items": {
              "type": "object",
              "required": [
                "model",
                "status",
                "content_md",
                "target_model_id"
              ],
              "properties": {
                "model": {
                  "type": "string"
                },
                "provenance": {
                  "$ref": "#/$defs/openrouter_provenance"
                },
                "status": {
                  "enum": [
                    "valid",
                    "invalid",
                    "unavailable"
                  ]
                },
                "content_md": {
                  "type": "string"
                },
                "target_model_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stance": {
                  "enum": [
                    "support",
                    "dispute",
                    "refine"
                  ]
                },
                "claim": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "challenge": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "why_decisive": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence_question": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "failure": {
                  "type": "string"
                },
                "raw_artifact": {
                  "type": "string"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "valid"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  },
                  "then": {
                    "required": [
                      "stance",
                      "claim",
                      "challenge",
                      "why_decisive"
                    ],
                    "properties": {
                      "target_model_id": {
                        "type": "string"
                      },
                      "claim": {
                        "type": "string"
                      },
                      "challenge": {
                        "type": "string"
                      },
                      "why_decisive": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          },
          "votes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "model",
                "content_md"
              ],
              "properties": {
                "provenance": {
                  "$ref": "#/$defs/openrouter_provenance"
                },
                "model": {
                  "type": "string"
                },
                "content_md": {
                  "type": "string"
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "recommendations": {
                  "type": "array",
                  "description": "Strukturierte Voten je Säule — registry-aufgelöst, damit das Frontend Protokollspalten + Revision OHNE Prosa-Parsing rendert. Aus dem geparsten Roh-Votum (extract_json_block), Org via organizations.resolve.",
                  "items": {
                    "type": "object",
                    "required": [
                      "pillar",
                      "organization_id",
                      "organization"
                    ],
                    "properties": {
                      "pillar": {
                        "enum": [
                          "A",
                          "B",
                          "C",
                          "D"
                        ]
                      },
                      "organization_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "organization": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "canonical_name aus Registry"
                      },
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "confidence": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "conditional": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "null, wenn das Modell kein gültiges JSON-Boolean lieferte — das Rohvotum bleibt sichtbar; als ungültig markiert wird es vom Aggregator (recommendations[].votes_invalid + Zählstand), nicht am Rohvotum. Sonst würde ein einziges vertragswidriges Votum die ganze Sitzung am Schema-Tor scheitern lassen — die Umkehrung der Grundsatzregel."
                      },
                      "reservation": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "decision": {
                        "enum": [
                          "recommend",
                          "abstain"
                        ]
                      },
                      "abstention_reason": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "decision": {
                              "const": "abstain"
                            }
                          },
                          "required": [
                            "decision"
                          ]
                        },
                        "then": {
                          "required": [
                            "abstention_reason",
                            "conditional",
                            "reservation"
                          ],
                          "properties": {
                            "organization_id": {
                              "type": "null"
                            },
                            "organization": {
                              "type": "null"
                            },
                            "conditional": {
                              "type": "null"
                            },
                            "reservation": {
                              "type": "null"
                            },
                            "abstention_reason": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "else": {
                          "properties": {
                            "organization_id": {
                              "type": "string"
                            },
                            "organization": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "dissent_md": {
      "type": "string"
    },
    "unresolved_votes": {
      "type": "array",
      "description": "Voten mit nicht zuordenbarer Organisation (nie stiller Dissens)",
      "items": {
        "type": "object",
        "required": [
          "pillar",
          "organization",
          "model"
        ]
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pillar",
          "has_consensus",
          "title",
          "organization",
          "donation_url",
          "confidence",
          "rationale_md"
        ],
        "properties": {
          "pillar": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "has_consensus": {
            "type": "boolean"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "null im dritten Zustand (kein gültiges Votum)"
          },
          "organization": {
            "type": [
              "string",
              "null"
            ],
            "description": "canonical_name aus Registry; null bei Dissens"
          },
          "organization_id": {
            "type": "string"
          },
          "donation_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "AUSSCHLIESSLICH aus Registry; null erlaubt"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ]
          },
          "rationale_md": {
            "type": "string"
          },
          "votes_valid": {
            "type": "integer",
            "description": "Auswertbare, registrierte Empfehlungen; bei explizitem Votumsvertrag werden Enthaltungen separat in votes_abstained gezählt."
          },
          "votes_invalid": {
            "type": "integer",
            "description": "teilnehmende Modelle ohne verwertbares Säulen-Votum (unlesbar/fehlend)"
          },
          "tie": {
            "type": "boolean",
            "description": "Gleichstand: mehrere Organisationen mit gleicher Modellzahl (kein Konsens)"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "z. B. Mehrfach-Votum eines Modells in einer Säule"
          },
          "votes_abstained": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "abstentions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "model",
                "reason"
              ],
              "properties": {
                "model": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "has_consensus": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "organization_id",
                "convergence"
              ],
              "properties": {
                "convergence": {
                  "type": "object",
                  "required": [
                    "count",
                    "total",
                    "conditional_count",
                    "models",
                    "votes"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "conditional_count": {
                      "type": "integer"
                    },
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "votes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "model",
                          "conditional",
                          "reservation"
                        ],
                        "properties": {
                          "model": {
                            "type": "string"
                          },
                          "conditional": {
                            "type": "boolean"
                          },
                          "reservation": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "has_consensus": {
                  "const": false
                },
                "votes_valid": {
                  "const": 0
                }
              },
              "required": [
                "votes_valid"
              ]
            },
            "then": {
              "description": "Dritter Zustand (kein gültiges Votum): kein individual_votes verlangt."
            },
            "else": {
              "if": {
                "properties": {
                  "has_consensus": {
                    "const": false
                  }
                }
              },
              "then": {
                "required": [
                  "individual_votes"
                ],
                "properties": {
                  "individual_votes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "title",
                        "organization",
                        "organization_id",
                        "donation_url",
                        "confidence",
                        "model",
                        "conditional",
                        "reservation"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "costs": {
      "$ref": "#/$defs/session_costs"
    },
    "correction_notice": {
      "type": "array",
      "description": "Nachträge zum Rekord: additive Hinweise (re-aggregierte Korrekturen ODER Einordnungen), kein Redigieren des Inhalts. Liste, damit mehrere Nachträge nebeneinander stehen.",
      "items": {
        "type": "object",
        "required": [
          "date",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "text_en": {
            "type": "string",
            "description": "BEWUSST NICHT GERENDERT. Der publizierte Rekord (inkl. Korrekturhinweise) bleibt deutsch — Konvention en.js:5, ein Test erzwingt sie; EN-Seiten markieren ihn über recordNote. text_en hält den Wart-Wortlaut treu im Rekord, ohne ihn anzuzeigen. Nicht als 'vergessen' reparieren — das ist Absicht (P9-Lehre umgekehrt: ein Vertragsfeld, das absichtlich nicht erscheint)."
          },
          "commit": {
            "type": "string"
          }
        }
      }
    },
    "wart_dossier": {
      "type": "object"
    },
    "deliberation_version": {
      "type": "string",
      "enum": [
        "0.5"
      ]
    },
    "designation": {
      "type": "string"
    },
    "led_by": {
      "type": "object"
    },
    "wart_opening_md": {
      "type": "string"
    },
    "wart_moderation_md": {
      "type": "string"
    },
    "wart_dossier_refusal": {
      "$ref": "#/$defs/wart_refusal"
    },
    "wart_opening_refusal": {
      "$ref": "#/$defs/wart_refusal"
    },
    "wart_moderation_refusal": {
      "$ref": "#/$defs/wart_refusal"
    },
    "summary_refusal": {
      "$ref": "#/$defs/wart_refusal"
    },
    "procedure_version": {
      "const": "0.6"
    },
    "ballot_contract": {
      "const": "explicit_abstention_v1",
      "description": "Nur neue Live-Sitzungen: Empfehlung oder Enthaltung ausdrücklich je Säule; alte Rekorde bleiben ohne dieses Feld."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "council_transport"
        ],
        "properties": {
          "council_transport": {
            "const": "openrouter_api"
          }
        }
      },
      "then": {
        "properties": {
          "rounds": {
            "items": {
              "properties": {
                "votes": {
                  "items": {
                    "required": [
                      "provenance"
                    ],
                    "properties": {
                      "model": {
                        "enum": [
                          "anthropic/claude-fable-5.1",
                          "openai/gpt-6-astra",
                          "x-ai/grok-4.6",
                          "moonshotai/kimi-k3",
                          "z-ai/glm-5.3"
                        ]
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "anthropic/claude-fable-5.1"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "anthropic/claude-fable-5.1"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "openai/gpt-6-astra"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "openai/gpt-6-astra"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "x-ai/grok-4.6"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "x-ai/grok-4.6"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "moonshotai/kimi-k3"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "moonshotai/kimi-k3"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "z-ai/glm-5.3"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "z-ai/glm-5.3"
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "exchanges": {
                  "items": {
                    "required": [
                      "provenance"
                    ],
                    "properties": {
                      "status": {
                        "const": "valid"
                      },
                      "model": {
                        "enum": [
                          "anthropic/claude-fable-5.1",
                          "openai/gpt-6-astra",
                          "x-ai/grok-4.6",
                          "moonshotai/kimi-k3",
                          "z-ai/glm-5.3"
                        ]
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "anthropic/claude-fable-5.1"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "anthropic/claude-fable-5.1"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "openai/gpt-6-astra"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "openai/gpt-6-astra"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "x-ai/grok-4.6"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "x-ai/grok-4.6"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "moonshotai/kimi-k3"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "moonshotai/kimi-k3"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "model": {
                              "const": "z-ai/glm-5.3"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "provenance": {
                              "properties": {
                                "requested_model": {
                                  "const": "z-ai/glm-5.3"
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "status",
          "council_transport",
          "procedure_version",
          "participants",
          "chair",
          "tally_rule",
          "pilot",
          "event_record"
        ],
        "properties": {
          "status": {
            "enum": [
              "completed",
              "incomplete"
            ]
          },
          "procedure_version": {
            "const": "0.6"
          },
          "participants": {
            "minItems": 5,
            "maxItems": 5
          },
          "chair": {
            "type": "object",
            "required": [
              "model",
              "rotation_index"
            ],
            "properties": {
              "model": {
                "type": "string"
              },
              "rotation_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            }
          },
          "tally_rule": {
            "const": "majority_3_of_5"
          },
          "pilot": {
            "type": "object",
            "required": [
              "all_five_final_votes_valid"
            ],
            "properties": {
              "all_five_final_votes_valid": {
                "type": "boolean"
              }
            }
          },
          "event_record": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "event_count"
            ],
            "properties": {
              "path": {
                "const": "events.json"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
